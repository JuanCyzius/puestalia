# Sin SUPABASE_* la web corre en MODO DEMO con avisos de ejemplo en memoria.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Clave de la API de Claude (console.anthropic.com). Necesaria para el panel de carga.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Contraseña del panel /admin (elegí una larga).
ADMIN_PASSWORD=
# Token para cargar avisos desde fuera del panel (conector, bot). Opcional.
INGEST_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Etapa 2 · Mercado Pago (Access Token de producción de tu aplicación). Vacío = Premium muestra la lista de espera.
MP_ACCESS_TOKEN=
# Opcional: clave secreta del webhook de Mercado Pago, para validar la firma de cada aviso.
MP_WEBHOOK_SECRET=
# Opcional: precio mensual en pesos (por defecto 4900).
MP_PRICE=
# Opcional: secreto para firmar las sesiones. Si falta se usa la clave de Supabase.
SESSION_SECRET=
