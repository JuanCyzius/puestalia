# Sin SUPABASE_* la web corre en MODO DEMO con avisos de ejemplo en memoria.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Clave de la API de Claude (console.anthropic.com). Necesaria para el panel de carga.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Contraseña del panel /admin (elegí una larga).
ADMIN_PASSWORD=
# Token para cargar avisos desde fuera del panel (conector, bot). Opcional.
INGEST_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enlace del plan de suscripción de Mercado Pago. Vacío = la página Premium muestra la lista de espera.
MP_SUBSCRIPTION_URL=
